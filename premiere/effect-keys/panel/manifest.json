{
  "id": "com.jakebench.effectkeys",
  "name": "Effect Keys",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "effectkeys",
      "label": {
        "default": "Effect Keys"
      },
      "minimumSize": {
        "width": 260,
        "height": 300
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 500
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 560
      }
    }
  ]
}