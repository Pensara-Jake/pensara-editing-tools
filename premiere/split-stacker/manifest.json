{
  "id": "com.jakebench.splitstacker",
  "name": "Split Stacker",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6.0"
    }
  ],
  "manifestVersion": 5,
  "requiredPermissions": {},
  "entrypoints": [
    {
      "type": "panel",
      "id": "splitstacker",
      "label": { "default": "Split Stacker" },
      "minimumSize": { "width": 240, "height": 300 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 280, "height": 400 },
      "preferredFloatingSize": { "width": 320, "height": 420 }
    }
  ]
}
